{
  "manifest_version": 3,
  "name": "BeterEnter for ChatGPT",
  "version": "1.3.0",
  "minimum_chrome_version": "111",
  "description": "ChatGPT の入力欄で Enter を Shift+Enter、Ctrl+Enter を通常の Enter に変更します。",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "BeterEnter for ChatGPT", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }, {
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["settings-bridge.js"],
    "run_at": "document_start",
    "world": "ISOLATED"
  }]
}
